PORT=8407
HOST=127.0.0.1
NODE_ENV=development

# One deployment serves one Stellar network.
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Single-signer mode: the account sources transactions and pays XLM network fees.
# Never put a real secret in git, logs, HTTP responses, or browser-side code.
FACILITATOR_STELLAR_PRIVATE_KEY=S_YOUR_TESTNET_FACILITATOR_SECRET

# Optional high-throughput mode. Set BOTH variables; the single-signer key is then unused.
# FACILITATOR_STELLAR_FEE_BUMP_SECRET=S_YOUR_FEE_BUMP_SECRET
# FACILITATOR_STELLAR_CHANNEL_SECRETS=S_CHANNEL_1,S_CHANNEL_2,S_CHANNEL_3

# Required on every network. Generate independently and copy the same value to the
# Resource Server's X402_FACILITATOR_API_KEY. Never expose it to buyers or browsers.
FACILITATOR_API_KEY=replace-with-a-long-random-server-to-server-token

# Matches @x402/stellar's conservative default; raise only after measuring testnet fees.
MAX_TRANSACTION_FEE_STROOPS=50000
MAX_BODY_SIZE=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SETTLEMENT_CACHE_TTL_MS=300000
SETTLEMENT_CACHE_MAX_ENTRIES=10000
# Optional usage-fact callback. The Bazaar endpoint must be configured with
# the same bearer token; reporting is best-effort and never rolls back a settle.
# BAZAAR_SETTLEMENT_URL=http://127.0.0.1:8402/discovery/settlements
# BAZAAR_SETTLEMENT_API_KEY=replace-with-a-bazaar-server-token
TRUST_PROXY=loopback,linklocal,uniquelocal
CORS_ORIGINS=*
SHUTDOWN_TIMEOUT_MS=10000
