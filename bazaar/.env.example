# Public origin advertised for the MCP endpoint (used to build the /mcp URL).
# Defaults to http://localhost:${MCP_PORT} when unset.
BASE_URL=https://agentsmith.xyz

# Required for the private facilitator -> Bazaar settlement callback.
# Keep this value server-side and match it in facilitator/.env.
BAZAAR_SETTLEMENT_API_KEY=replace-with-a-bazaar-server-token
