{
  "name": "@agentsmith/bazaar",
  "version": "0.1.0",
  "private": true,
  "description": "x402 Bazaar discovery service — query understanding, structured filtering and hybrid candidate retrieval over PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "reset": "node scripts/migrate.js --drop",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db": "/opt/homebrew/opt/postgresql@16/bin/psql \"${DATABASE_URL:-postgres://localhost:5432/bazaar}\"",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  }
}
